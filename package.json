{
  "name": "myleaf",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter \"@myleaf/server...\" run build && pnpm --parallel --filter @myleaf/server --filter @myleaf/web run dev",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "playwright test",
    "bench": "pnpm --filter \"@myleaf/compile-texlive...\" run build && node packages/compile-texlive/bench/compile-bench.ts",
    "bench:images": "pnpm --filter \"@myleaf/compile-texlive...\" run build && node packages/compile-texlive/bench/image-bench.ts",
    "bench:live-compression": "pnpm --filter \"@myleaf/server...\" run build && node apps/server/bench/live-compression-bench.ts",
    "bench:live-typing": "pnpm --filter \"@myleaf/live-pdftex...\" run build && node packages/live-pdftex/bench/typing-bench.ts",
    "bench:pdftex-hooks": "node packages/compile-texlive/bench/pdftex-hooks-bench.ts",
    "bench:pdftex-warm": "node packages/compile-texlive/bench/pdftex-warm-bench.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "fflate": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
