+/* The pause: the engine serves commands until one forks a child, and
+   returns in the child.  The engine process itself never returns.  */
+static void
+myleaf_pause (struct myleaf_stream *main_stream)
+{
+  /* Cookie streams write into their real files, so flush twice.  */
+  fflush (NULL);
+  fflush (NULL);
+  myleaf_send ("ready\n");
+  myleaf_serve (main_stream, 0, NULL);
+}
+
+/* In a run child, at the first read of a TeX input after a shipout (all
+   bytes before READING's position have been consumed): forks.  The child
+   goes on typesetting; this process becomes a snapshot that the driver can
+   resume from with an edit after what it read of each input.  */
+static void
+myleaf_snapshot (struct myleaf_stream *reading)
+{
+  pid_t pid, parent = getpid (), self;
+  int page = myleaf_snapshot_page;
+  struct myleaf_stream *s;
+  struct myleaf_closed *c;
+  myleaf_snapshot_page = 0;
+  if (myleaf_snapshot_left > 0)
+    myleaf_snapshot_left--;
+  fflush (NULL);
+  fflush (NULL);
+  funlockfile (reading->wrapped);
+  pid = fork ();
+  flockfile (reading->wrapped);
+  if (pid == 0)
+    myleaf_follow_parent (parent);
+  if (pid <= 0)
+    return; /* the child, or no snapshot */
+  self = getpid ();
+  for (c = myleaf_closed; c; c = c->next)
+    myleaf_send ("file\t%ld\t%llu\t%d\t%s\n", (long) self, c->pos,
+                 c->eof ? 1 : 0, c->name);
+  for (s = myleaf_streams; s; s = s->next)
+    if (!s->is_output)
+      myleaf_send ("file\t%ld\t%llu\t%d\t%s\n", (long) self, s->pos,
+                   s->eof ? 1 : 0, s->name);
+  myleaf_send ("snapshot\t%s\t%d\t%llu\t%ld\t%ld\n", myleaf_run_id, page,
+               myleaf_main ? myleaf_main->pos : 0ULL, (long) self, (long) pid);
+  myleaf_serve (reading, pid, xstrdup (myleaf_run_id));
+}
