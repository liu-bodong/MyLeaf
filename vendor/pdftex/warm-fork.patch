 struct myleaf_stream {
   FILE *file;
+  FILE *wrapped;               /* the stream returned to TeX */
   char *name;
   unsigned long long nread, nwritten;
+  unsigned long long pos;      /* bytes read so far (input is not seeked) */
+  boolean is_output, is_main;
