+/* Writes output files to OUTDIR from now on, including those already open
+   (their content so far is copied), and terminal output to
+   OUTDIR/terminal.txt.  Streams must be flushed before.  */
+static void
+myleaf_redirect_outputs (const char *outdir)
+{
+  struct myleaf_stream *s;
+  FILE *f;
+  int fd;
+  output_directory = xstrdup (outdir);
+  /* Terminal output goes to a file in OUTDIR, so children do not mix it on
+     the engine's stdout.  */
+  {
+    string path = concat3 (outdir, DIR_SEP_STRING, "terminal.txt");
+    fd = open (path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    free (path);
+    if (fd >= 0) {
+      dup2 (fd, STDOUT_FILENO);
+      close (fd);
+    }
+  }
+  for (s = myleaf_streams; s; s = s->next) {
+    const char *base;
+    string path;
+    if (!s->is_output)
+      continue;
+    base = strrchr (s->name, '/');
+    base = base ? base + 1 : s->name;
+    path = concat3 (outdir, DIR_SEP_STRING, base);
+    f = fopen (path, "w+b");
+    if (f) {
+      myleaf_copy_prefix (s->file, s->size, f);
+      fseeko (f, (off_t) s->wpos, SEEK_SET);
+      fclose (s->file);
+      s->file = f;
+      free (s->name);
+      s->name = path;
+    } else {
+      free (path);
+    }
+  }
+}
+
+/* In a new child: read the rest of the main file from MAIN_FILE and write
+   output files to OUTDIR, including those already open (the log).  It keeps
+   the control descriptor for "page" messages.  Inputs open in the parent
+   are opened again, by name, at the position read so far: the parent's
+   descriptors share their offset with processes forked before (which read
+   further), and the file may have changed after that position.  */
+static void
+myleaf_become_child (const char *id, const char *main_file,
+                     const char *outdir)
+{
+  struct myleaf_stream *s;
+  myleaf_pause_offset = -1;
+  free (myleaf_run_id);
+  free (myleaf_run_dir);
+  myleaf_run_id = xstrdup (id);
+  myleaf_run_dir = xstrdup (outdir);
+
+  myleaf_redirect_outputs (outdir);
+  for (s = myleaf_streams; s; s = s->next) {
+    const char *name = s == myleaf_main ? main_file : s->name;
+    FILE *f;
+    if (s->is_output)
+      continue;
+    f = fopen (name, "rb");
+    if (f) {
+      fclose (s->file);
+      s->file = f;
+    }
+    if ((!f && s == myleaf_main)
+        || fseeko (s->file, (off_t) s->pos, SEEK_SET) != 0) {
+      fprintf (stderr, "myleaf: cannot read %s\n", name);
+      _exit (3);
+    }
+  }
+}
+
+/* Called after page PAGE was shipped out.  In a run child with PAGE in its
+   range, forks a finisher and returns true in it: its output now goes to
+   <run-dir>/page-<PAGE>, and the caller closes the PDF there and calls
+   myleaf_page_finished.  Otherwise returns false.  */
+boolean
+myleaf_fork_page (int page)
+{
+  pid_t pid;
+  string dir;
+  char name[32];
+  if (!myleaf_run_id)
+    return false;
+  if (myleaf_snapshots && myleaf_snapshot_left != 0
+      && page % myleaf_snapshot_every == 0)
+    myleaf_snapshot_page = page;
+  if (page < myleaf_first_page || page > myleaf_last_page)
+    return false;
+  /* Collect finishers that are done.  */
+  while (waitpid (-1, NULL, WNOHANG) > 0)
+    ;
+  /* Cookie streams write into their real files, so flush twice.  */
+  fflush (NULL);
+  fflush (NULL);
+  pid = fork ();
+  if (pid != 0)
+    return false;
+  snprintf (name, sizeof name, "page-%d", page);
+  dir = concat3 (myleaf_run_dir, DIR_SEP_STRING, name);
+  if (mkdir (dir, 0777) != 0 && errno != EEXIST)
+    _exit (3);
+  myleaf_redirect_outputs (dir);
+  myleaf_finisher_page = page;
+  myleaf_finisher_dir = dir;
+  return true;
+}
+
+/* In a finisher, after the PDF was closed: tells the driver and exits.  */
+void
+myleaf_page_finished (void)
+{
+  fflush (NULL);
+  fflush (NULL);
+  myleaf_send ("page\t%s\t%d\t%s\n", myleaf_run_id, myleaf_finisher_page,
+               myleaf_finisher_dir);
+  _exit (0);
+}
+
+/* In a process of the chain after the engine: its parent there.  When the
+   driver kills a snapshot, the processes after it must end too (on Linux
+   the kernel does it; elsewhere they check at each read of the main file
+   and before serving).  */
+static pid_t myleaf_parent;
+static void myleaf_check_parent (void);
+
+static void
+myleaf_follow_parent (pid_t parent)
+{
+  myleaf_parent = parent;
+#ifdef __linux__
+  prctl (PR_SET_PDEATHSIG, SIGKILL);
+#endif
+  myleaf_check_parent ();
+}
+
+static void
+myleaf_check_parent (void)
+{
+  if (myleaf_parent && getppid () != myleaf_parent)
+    _exit (0);
+}
+
+/* Waits for CHILD, collecting finishers on the way; returns its status
+   (exit status, or minus the signal).  */
+static int
+myleaf_wait (pid_t child)
+{
+  int status;
+  for (;;) {
+    pid_t pid = waitpid (-1, &status, 0);
+    if (pid < 0 && errno == EINTR)
+      continue;
+    if (pid < 0)
+      return -255;
+    if (pid == child)
+      return WIFEXITED (status) ? WEXITSTATUS (status) : -WTERMSIG (status);
+  }
+}
+
+/* Forks for a "run" command, from inside a read of READING.  Returns the
+   child's pid in the parent, 0 in the child (which reads the rest of the
+   main file from MAIN_FILE).  */
+static pid_t
+myleaf_fork_run (struct myleaf_stream *reading, char **fields, int n)
+{
+  pid_t pid;
+  /* We are inside a stdio read of READING, which holds its lock.
+     On macOS the child's thread cannot release a lock taken by the
+     parent's thread, so the child would block on its next read.  Release
+     the lock across the fork; each process takes it again.  */
+  pid_t parent = getpid ();
+  funlockfile (reading->wrapped);
+  pid = fork ();
+  flockfile (reading->wrapped);
+  if (pid == 0) {
+    if (myleaf_run_id)
+      myleaf_follow_parent (parent); /* run from a snapshot */
+    myleaf_become_child (fields[1], fields[2], fields[3]);
+    myleaf_first_page = 1;
+    myleaf_last_page = 0;
+    myleaf_snapshot_every = 1;
+    myleaf_snapshot_left = -1;
+    if (n >= 6) {
+      myleaf_first_page = atoi (fields[4]);
+      myleaf_last_page = atoi (fields[5]);
+    }
+    if (n == 8) {
+      myleaf_snapshot_every = atoi (fields[6]);
+      myleaf_snapshot_left = atoi (fields[7]);
+      if (myleaf_snapshot_every < 1)
+        myleaf_snapshot_every = 1;
+    }
+  }
+  return pid;
+}
+
+/* Serves the driver from a paused process: the engine at the pause, or a
+   snapshot.  Processes form a chain (engine, snapshots, the running child),
+   and only the last paused one reads commands: each first waits for its
+   child CHILD (of run RUN_ID), if any, to exit, says "done" for that run and
+   "resumed" with its pid, then reads commands.  The driver goes back to a
+   snapshot by killing the processes after it.  Returns in a new child.
+   READING is the stream whose read is in progress.  */
+static void
+myleaf_serve (struct myleaf_stream *reading, pid_t child, char *run_id)
+{
+  static char buf[8192];
+  static size_t used;
+  for (;;) {
+    char *start, *nl;
+    ssize_t n;
+    if (child > 0) {
+      int status = myleaf_wait (child);
+      myleaf_check_parent ();
+      myleaf_send ("done\t%s\t%d\n", run_id, status);
+      myleaf_send ("resumed\t%ld\n", (long) getpid ());
+      free (run_id);
+      child = 0;
+    }
+    /* Lines read before the last fork.  */
+    start = buf;
+    buf[used] = 0;
+    while (child == 0 && (nl = strchr (start, '\n')) != NULL) {
+      char *fields[8];
+      int nf = 0;
+      char *p = start;
+      *nl = 0;
+      start = nl + 1;
+      while (nf < 8) {
+        fields[nf++] = p;
+        p = strchr (p, '\t');
+        if (!p)
+          break;
+        *p++ = 0;
+      }
+      if ((nf == 4 || nf == 6 || nf == 8) && STREQ (fields[0], "run")) {
+        pid_t pid = myleaf_fork_run (reading, fields, nf);
+        if (pid == 0) {
+          used = 0;
+          return;
+        }
+        if (pid < 0) {
+          myleaf_send ("done\t%s\t%d\n", fields[1], -255);
+          continue;
+        }
+        myleaf_send ("started\t%s\t%ld\n", fields[1], (long) pid);
+        child = pid;
+        run_id = xstrdup (fields[1]);
+      }
+    }
+    used -= (size_t) (start - buf);
+    memmove (buf, start, used);
+    if (child > 0)
+      continue;
+    if (used == sizeof buf - 1)
+      used = 0; /* an overlong line: drop it */
+    n = read (myleaf_control_fd, buf + used, sizeof buf - used - 1);
+    if (n < 0 && errno == EINTR)
+      continue;
+    if (n <= 0)
+      _exit (0); /* the driver is gone */
+    used += (size_t) n;
+  }
+}
