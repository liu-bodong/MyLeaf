+/* Writes one message to the driver.  */
+static void
+myleaf_send (const char *fmt, ...)
+{
+  char line[4096];
+  va_list ap;
+  size_t done = 0, len;
+  int n;
+  va_start (ap, fmt);
+  n = vsnprintf (line, sizeof line, fmt, ap);
+  va_end (ap);
+  if (n < 0)
+    return;
+  len = (size_t) n < sizeof line ? (size_t) n : sizeof line - 1;
+  while (done < len) {
+    ssize_t w = write (myleaf_control_fd, line + done, len - done);
+    if (w < 0 && errno == EINTR)
+      continue;
+    if (w <= 0)
+      return;
+    done += (size_t) w;
+  }
+}
+
+/* Copies the first SIZE bytes of the file open as FROM into the stream TO.
+   Reads with pread: the descriptor's offset can be shared with processes
+   forked from this one (snapshots), which wrote further.  */
+static void
+myleaf_copy_prefix (FILE *from, unsigned long long size, FILE *to)
+{
+  char buf[65536];
+  unsigned long long done = 0;
+  int fd = fileno (from);
+  while (done < size) {
+    size_t want = size - done < sizeof buf ? (size_t) (size - done) : sizeof buf;
+    ssize_t n = pread (fd, buf, want, (off_t) done);
+    if (n < 0 && errno == EINTR)
+      continue;
+    if (n <= 0)
+      break;
+    fwrite (buf, 1, (size_t) n, to);
+    done += (unsigned long long) n;
+  }
+}
+
+/* Writes output files to OUTDIR from now on, including those already open
+   (their content so far is copied), and terminal output to
+   OUTDIR/terminal.txt.  Streams must be flushed before.  */
+static void
+myleaf_redirect_outputs (const char *outdir)
+{
+  struct myleaf_stream *s;
+  FILE *f;
+  int fd;
+  output_directory = xstrdup (outdir);
+  /* Terminal output goes to a file in OUTDIR, so children do not mix it on
+     the engine's stdout.  */
+  {
+    string path = concat3 (outdir, DIR_SEP_STRING, "terminal.txt");
+    fd = open (path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    free (path);
+    if (fd >= 0) {
+      dup2 (fd, STDOUT_FILENO);
+      close (fd);
+    }
+  }
+  for (s = myleaf_streams; s; s = s->next) {
+    const char *base;
+    string path;
+    if (!s->is_output)
+      continue;
+    base = strrchr (s->name, '/');
+    base = base ? base + 1 : s->name;
+    path = concat3 (outdir, DIR_SEP_STRING, base);
+    f = fopen (path, "w+b");
+    if (f) {
+      myleaf_copy_prefix (s->file, s->size, f);
+      fseeko (f, (off_t) s->wpos, SEEK_SET);
+      fclose (s->file);
+      s->file = f;
+      free (s->name);
+      s->name = path;
+    } else {
+      free (path);
+    }
+  }
+}
+
+/* In a new child: read the rest of MAIN_STREAM from MAIN_FILE and write
+   output files to OUTDIR, including those already open (the log).  It keeps
+   the control descriptor for "page" messages.  */
+static void
+myleaf_become_child (struct myleaf_stream *main_stream, const char *id,
+                     const char *main_file, const char *outdir)
+{
+  FILE *f;
+  myleaf_pause_offset = -1;
+  free (myleaf_run_id);
+  free (myleaf_run_dir);
+  myleaf_run_id = xstrdup (id);
+  myleaf_run_dir = xstrdup (outdir);
+
+  myleaf_redirect_outputs (outdir);
+  f = fopen (main_file, "rb");
+  if (!f || fseeko (f, (off_t) main_stream->pos, SEEK_SET) != 0) {
+    fprintf (stderr, "myleaf: cannot read %s\n", main_file);
+    _exit (3);
+  }
+  fclose (main_stream->file);
+  main_stream->file = f;
+}
+
+/* Called after page PAGE was shipped out.  In a run child with PAGE in its
+   range, forks a finisher and returns true in it: its output now goes to
+   <run-dir>/page-<PAGE>, and the caller closes the PDF there and calls
+   myleaf_page_finished.  Otherwise returns false.  */
+boolean
+myleaf_fork_page (int page)
+{
+  pid_t pid;
+  string dir;
+  char name[32];
+  if (!myleaf_run_id)
+    return false;
+  if (myleaf_snapshots)
+    myleaf_snapshot_page = page;
+  if (page < myleaf_first_page || page > myleaf_last_page)
+    return false;
+  /* Collect finishers that are done.  */
+  while (waitpid (-1, NULL, WNOHANG) > 0)
+    ;
+  /* Cookie streams write into their real files, so flush twice.  */
+  fflush (NULL);
+  fflush (NULL);
+  pid = fork ();
+  if (pid != 0)
+    return false;
+  snprintf (name, sizeof name, "page-%d", page);
+  dir = concat3 (myleaf_run_dir, DIR_SEP_STRING, name);
+  if (mkdir (dir, 0777) != 0 && errno != EEXIST)
+    _exit (3);
+  myleaf_redirect_outputs (dir);
+  myleaf_finisher_page = page;
+  myleaf_finisher_dir = dir;
+  return true;
+}
+
+/* In a finisher, after the PDF was closed: tells the driver and exits.  */
+void
+myleaf_page_finished (void)
+{
+  fflush (NULL);
+  fflush (NULL);
+  myleaf_send ("page\t%s\t%d\t%s\n", myleaf_run_id, myleaf_finisher_page,
+               myleaf_finisher_dir);
+  _exit (0);
+}
+
+/* In a process of the chain after the engine: its parent there.  When the
+   driver kills a snapshot, the processes after it must end too (on Linux
+   the kernel does it; elsewhere they check at each read of the main file
+   and before serving).  */
+static pid_t myleaf_parent;
+static void myleaf_check_parent (void);
+
+static void
+myleaf_follow_parent (pid_t parent)
+{
+  myleaf_parent = parent;
+#ifdef __linux__
+  prctl (PR_SET_PDEATHSIG, SIGKILL);
+#endif
+  myleaf_check_parent ();
+}
+
+static void
+myleaf_check_parent (void)
+{
+  if (myleaf_parent && getppid () != myleaf_parent)
+    _exit (0);
+}
+
+/* Waits for CHILD, collecting finishers on the way; returns its status
+   (exit status, or minus the signal).  */
+static int
+myleaf_wait (pid_t child)
+{
+  int status;
+  for (;;) {
+    pid_t pid = waitpid (-1, &status, 0);
+    if (pid < 0 && errno == EINTR)
+      continue;
+    if (pid < 0)
+      return -255;
+    if (pid == child)
+      return WIFEXITED (status) ? WEXITSTATUS (status) : -WTERMSIG (status);
+  }
+}
+
+/* Forks for a "run" command.  Returns the child's pid in the parent, 0 in
+   the child (which reads the rest of MAIN_STREAM from MAIN_FILE).  */
+static pid_t
+myleaf_fork_run (struct myleaf_stream *main_stream, char **fields, int n)
+{
+  pid_t pid;
+  /* We are inside a stdio read of the main stream, which holds its lock.
+     On macOS the child's thread cannot release a lock taken by the
+     parent's thread, so the child would block on its next read.  Release
+     the lock across the fork; each process takes it again.  */
+  pid_t parent = getpid ();
+  funlockfile (main_stream->wrapped);
+  pid = fork ();
+  flockfile (main_stream->wrapped);
+  if (pid == 0) {
+    if (myleaf_run_id)
+      myleaf_follow_parent (parent); /* run from a snapshot */
+    myleaf_become_child (main_stream, fields[1], fields[2], fields[3]);
+    myleaf_first_page = 1;
+    myleaf_last_page = 0;
+    if (n == 6) {
+      myleaf_first_page = atoi (fields[4]);
+      myleaf_last_page = atoi (fields[5]);
+    }
+  }
+  return pid;
+}
+
+/* Serves the driver from a paused process: the engine at the pause, or a
+   snapshot.  Processes form a chain (engine, snapshots, the running child),
+   and only the last paused one reads commands: each first waits for its
+   child CHILD (of run RUN_ID), if any, to exit, says "done" for that run and
+   "resumed" with its pid, then reads commands.  The driver goes back to a
+   snapshot by killing the processes after it.  Returns in a new child.  */
+static void
+myleaf_serve (struct myleaf_stream *main_stream, pid_t child, char *run_id)
+{
+  static char buf[8192];
+  static size_t used;
+  for (;;) {
+    char *start, *nl;
+    ssize_t n;
+    if (child > 0) {
+      int status = myleaf_wait (child);
+      myleaf_check_parent ();
+      myleaf_send ("done\t%s\t%d\n", run_id, status);
+      myleaf_send ("resumed\t%ld\n", (long) getpid ());
+      free (run_id);
+      child = 0;
+    }
+    /* Lines read before the last fork.  */
+    start = buf;
+    buf[used] = 0;
+    while (child == 0 && (nl = strchr (start, '\n')) != NULL) {
+      char *fields[6];
+      int nf = 0;
+      char *p = start;
+      *nl = 0;
+      start = nl + 1;
+      while (nf < 6) {
+        fields[nf++] = p;
+        p = strchr (p, '\t');
+        if (!p)
+          break;
+        *p++ = 0;
+      }
+      if ((nf == 4 || nf == 6) && STREQ (fields[0], "run")) {
+        pid_t pid = myleaf_fork_run (main_stream, fields, nf);
+        if (pid == 0) {
+          used = 0;
+          return;
+        }
+        if (pid < 0) {
+          myleaf_send ("done\t%s\t%d\n", fields[1], -255);
+          continue;
+        }
+        myleaf_send ("started\t%s\t%ld\n", fields[1], (long) pid);
+        child = pid;
+        run_id = xstrdup (fields[1]);
+      }
+    }
+    used -= (size_t) (start - buf);
+    memmove (buf, start, used);
+    if (child > 0)
+      continue;
+    if (used == sizeof buf - 1)
+      used = 0; /* an overlong line: drop it */
+    n = read (myleaf_control_fd, buf + used, sizeof buf - used - 1);
+    if (n < 0 && errno == EINTR)
+      continue;
+    if (n <= 0)
+      _exit (0); /* the driver is gone */
+    used += (size_t) n;
+  }
+}
+
+/* The pause: the engine serves commands until one forks a child, and
+   returns in the child.  The engine process itself never returns.  */
+static void
+myleaf_pause (struct myleaf_stream *main_stream)
+{
+  /* Cookie streams write into their real files, so flush twice.  */
+  fflush (NULL);
+  fflush (NULL);
+  myleaf_send ("ready\n");
+  myleaf_serve (main_stream, 0, NULL);
+}
+
+/* In a run child, at the first read of the main file after a shipout (all
+   bytes before MAIN_STREAM's position have been consumed): forks.  The
+   child goes on typesetting; this process becomes a snapshot that the
+   driver can resume from with an edit after that position.  */
+static void
+myleaf_snapshot (struct myleaf_stream *main_stream)
+{
+  pid_t pid, parent = getpid ();
+  int page = myleaf_snapshot_page;
+  myleaf_snapshot_page = 0;
+  fflush (NULL);
+  fflush (NULL);
+  funlockfile (main_stream->wrapped);
+  pid = fork ();
+  flockfile (main_stream->wrapped);
+  if (pid == 0)
+    myleaf_follow_parent (parent);
+  if (pid <= 0)
+    return; /* the child, or no snapshot */
+  myleaf_send ("snapshot\t%s\t%d\t%llu\t%ld\t%ld\n", myleaf_run_id, page,
+               main_stream->pos, (long) getpid (), (long) pid);
+  myleaf_serve (main_stream, pid, xstrdup (myleaf_run_id));
+}
