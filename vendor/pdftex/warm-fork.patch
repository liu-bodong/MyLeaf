+/* Copies the first SIZE bytes of the file open as FROM into the stream TO.
+   Reads with pread: the descriptor's offset can be shared with processes
+   forked from this one (snapshots), which wrote further.  */
+static void
+myleaf_copy_prefix (FILE *from, unsigned long long size, FILE *to)
+{
+  char buf[65536];
+  unsigned long long done = 0;
+  int fd = fileno (from);
+  while (done < size) {
+    size_t want = size - done < sizeof buf ? (size_t) (size - done) : sizeof buf;
+    ssize_t n = pread (fd, buf, want, (off_t) done);
+    if (n < 0 && errno == EINTR)
+      continue;
+    if (n <= 0)
+      break;
+    fwrite (buf, 1, (size_t) n, to);
+    done += (unsigned long long) n;
+  }
+}
