 static long
 myleaf_read_impl (void *cookie, char *buf, size_t size)
 {
   struct myleaf_stream *s = cookie;
-  size_t n = fread (buf, 1, size, s->file);
+  size_t n;
+  if (s->is_main && myleaf_pause_offset >= 0) {
+    unsigned long long pause = (unsigned long long) myleaf_pause_offset;
+    if (s->pos >= pause)
+      myleaf_pause (s); /* returns in a child, reading new content */
+    else if (s->pos + size > pause)
+      size = (size_t) (pause - s->pos);
+  }
+  n = fread (buf, 1, size, s->file);
   if (n == 0 && ferror (s->file))
     return -1;
   s->nread += n;
+  s->pos += n;
   return (long) n;
 }
 
