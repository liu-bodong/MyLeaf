+/* MyLeaf warm fork (levels 2 and 3, docs/spikes/pdflatex-live-preview.md).
+   With MYLEAF_PDFTEX_PAUSE_OFFSET=<n> and MYLEAF_PDFTEX_CONTROL_FD=<fd> as
+   well, pdfTeX stops when it is about to read byte <n> of the main file,
+   says "ready" on the control descriptor, and forks a child for a "run"
+   command.  The child reads the rest of the main file from the new content
+   and writes its output to its own directory.  Messages are lines of
+   tab-separated fields:
+     engine -> driver:  input <path>        (file read before the pause)
+                        ready
+                        started <id> <pid>  (the run's child)
+                        done <id> <status>  (child exited; status, or -signal)
+                        resumed <pid>       (that process reads commands)
+     driver -> engine:  run <id> <main-file> <output-dir> [<first> <last>]
+   With <first> and <last> (level 3, page-by-page output), each time the
+   child ships out a page in that range it forks a finisher that closes the
+   PDF there (pages 1 to that page) in <output-dir>/page-<n> and says
+                        page <id> <n> <dir>
+   With MYLEAF_PDFTEX_SNAPSHOTS (level 3), at the first read of the main
+   file after each shipout the child forks: the new process goes on, and
+   this one stays as a snapshot of the state after <pos> bytes of the main
+   file.  It says
+                        snapshot <id> <n> <pos> <pid> <child-pid>
+   Paused processes form a chain (engine, snapshots, the running child):
+   one reads commands only while it has no child.  To cancel a run, the
+   driver kills its child; to run from a snapshot (bytes before <pos>
+   unchanged), it kills the snapshots after it and waits for "resumed".
+   The process reading commands exits when the descriptor is closed.  */
+static long long myleaf_pause_offset = -1;
+static int myleaf_control_fd = -1;
+static boolean myleaf_main_seen;
+/* In a child: its run, its output directory and the pages to finish.  */
+static char *myleaf_run_id, *myleaf_run_dir;
+static int myleaf_first_page = 1, myleaf_last_page = 0;
+/* With MYLEAF_PDFTEX_SNAPSHOTS: in a run child, the page after whose
+   shipout a snapshot is due (0: none).  */
+static boolean myleaf_snapshots;
+static int myleaf_snapshot_page;
+/* In a finisher: the page it finishes and its directory.  */
+static int myleaf_finisher_page;
+static char *myleaf_finisher_dir;
 
