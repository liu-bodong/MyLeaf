 static int myleaf_hooks_state = -1; /* -1 unknown, 0 off, 1 on */
 static FILE *myleaf_log;
+static struct myleaf_stream *myleaf_streams;
+
+/* MyLeaf warm fork (level 2, docs/spikes/pdflatex-live-preview.md).  With
+   MYLEAF_PDFTEX_PAUSE_OFFSET=<n> and MYLEAF_PDFTEX_CONTROL_FD=<fd> as well,
+   pdfTeX stops when it is about to read byte <n> of the main file (the line
+   holding \begin{document}), says "ready" on the control descriptor, and
+   forks a child for each "run" command.  The child reads the rest of the
+   main file from the new content and writes its output to its own
+   directory.  Messages are lines of tab-separated fields:
+     engine -> driver:  input <path>        (file read before the pause)
+                        ready
+                        done <id> <status>  (child exited; status, or -signal)
+     driver -> engine:  run <id> <main-file> <output-dir>
+                        cancel <id>
+   The engine exits when the control descriptor is closed.  */
+static long long myleaf_pause_offset = -1;
+static int myleaf_control_fd = -1;
+static boolean myleaf_main_seen;
 
 static boolean
 myleaf_hooks_enabled (void)
 {
   if (myleaf_hooks_state < 0) {
     const char *log_name = getenv ("MYLEAF_PDFTEX_HOOK_LOG");
+    const char *offset = getenv ("MYLEAF_PDFTEX_PAUSE_OFFSET");
+    const char *control = getenv ("MYLEAF_PDFTEX_CONTROL_FD");
     myleaf_hooks_state = getenv ("MYLEAF_PDFTEX_HOOKS") != NULL;
     if (myleaf_hooks_state && log_name && *log_name) {
       myleaf_log = fopen (log_name, "w");
       if (myleaf_log)
         setvbuf (myleaf_log, NULL, _IOLBF, 0);
     }
+    if (myleaf_hooks_state && offset && *offset && control && *control) {
+      myleaf_pause_offset = atoll (offset);
+      myleaf_control_fd = atoi (control);
+    }
   }
   return myleaf_hooks_state == 1;
 }
