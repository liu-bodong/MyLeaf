+/* MyLeaf live preview, level 3 (page-by-page output): after page PAGE was
+   shipped out, a run child of the warm-fork engine may fork a finisher
+   (myleaf_fork_page in lib/openclose.c) that closes the PDF right there, so
+   the driver can show that page before the rest is typeset.  */
+void myleafshippedout(integer page)
+{
+    if (myleaf_fork_page(page)) {
+        closefilesandterminate();
+        myleaf_page_finished();
+    }
+}
