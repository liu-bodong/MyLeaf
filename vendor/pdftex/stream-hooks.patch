diff --git a/texk/web2c/lib/openclose.c b/texk/web2c/lib/openclose.c
index 1dda1941..6f57dd66 100644
--- a/texk/web2c/lib/openclose.c
+++ b/texk/web2c/lib/openclose.c
@@ -85,6 +85,166 @@ string output_directory;     /* Defaults to NULL.  */
 int tfmtemp;
 int ocptemp;
 int texinputtype;
+
+/* MyLeaf: stream hooks (vendor/pdftex, docs/spikes/pdflatex-live-preview.md).
+   When MYLEAF_PDFTEX_HOOKS is set in the environment, every file opened by
+   open_input and open_output (except dump files, which zlib reads through
+   the file descriptor) is returned as a custom stream that passes reads,
+   writes and seeks through to the real file.  A later step replaces the
+   pass-through with a driver (TeXpresso-style).  If MYLEAF_PDFTEX_HOOK_LOG
+   names a file, each open and close is logged there.  */
+#if defined(__linux__) || defined(__APPLE__)
+#define MYLEAF_HOOKS 1
+#include <stdarg.h>
+
+struct myleaf_stream {
+  FILE *file;
+  char *name;
+  unsigned long long nread, nwritten;
+};
+
+static int myleaf_hooks_state = -1; /* -1 unknown, 0 off, 1 on */
+static FILE *myleaf_log;
+
+static boolean
+myleaf_hooks_enabled (void)
+{
+  if (myleaf_hooks_state < 0) {
+    const char *log_name = getenv ("MYLEAF_PDFTEX_HOOK_LOG");
+    myleaf_hooks_state = getenv ("MYLEAF_PDFTEX_HOOKS") != NULL;
+    if (myleaf_hooks_state && log_name && *log_name) {
+      myleaf_log = fopen (log_name, "w");
+      if (myleaf_log)
+        setvbuf (myleaf_log, NULL, _IOLBF, 0);
+    }
+  }
+  return myleaf_hooks_state == 1;
+}
+
+static void
+myleaf_logf (const char *fmt, ...)
+{
+  va_list ap;
+  if (!myleaf_log)
+    return;
+  va_start (ap, fmt);
+  vfprintf (myleaf_log, fmt, ap);
+  va_end (ap);
+}
+
+static long
+myleaf_read_impl (void *cookie, char *buf, size_t size)
+{
+  struct myleaf_stream *s = cookie;
+  size_t n = fread (buf, 1, size, s->file);
+  if (n == 0 && ferror (s->file))
+    return -1;
+  s->nread += n;
+  return (long) n;
+}
+
+static long
+myleaf_write_impl (void *cookie, const char *buf, size_t size)
+{
+  struct myleaf_stream *s = cookie;
+  size_t n = fwrite (buf, 1, size, s->file);
+  if (n < size && ferror (s->file))
+    return n ? (long) n : -1;
+  s->nwritten += n;
+  return (long) n;
+}
+
+static int
+myleaf_seek_impl (void *cookie, off_t *offset, int whence)
+{
+  struct myleaf_stream *s = cookie;
+  if (fseeko (s->file, *offset, whence) != 0)
+    return -1;
+  *offset = ftello (s->file);
+  return 0;
+}
+
+static int
+myleaf_close_impl (void *cookie)
+{
+  struct myleaf_stream *s = cookie;
+  int ret = fclose (s->file);
+  myleaf_logf ("close\t%s\t%llu\t%llu\n", s->name, s->nread, s->nwritten);
+  free (s->name);
+  free (s);
+  return ret;
+}
+
+#ifdef __linux__
+static ssize_t
+myleaf_read (void *c, char *b, size_t n) { return myleaf_read_impl (c, b, n); }
+static ssize_t
+myleaf_write (void *c, const char *b, size_t n) { return myleaf_write_impl (c, b, n); }
+#ifdef __GLIBC__
+typedef __off64_t myleaf_cookie_off_t;
+#else
+typedef off_t myleaf_cookie_off_t;
+#endif
+static int
+myleaf_seek (void *c, myleaf_cookie_off_t *offset, int whence)
+{
+  off_t o = (off_t) *offset;
+  int ret = myleaf_seek_impl (c, &o, whence);
+  *offset = o;
+  return ret;
+}
+#else /* __APPLE__: funopen */
+static int
+myleaf_read (void *c, char *b, int n) { return (int) myleaf_read_impl (c, b, (size_t) n); }
+static int
+myleaf_write (void *c, const char *b, int n) { return (int) myleaf_write_impl (c, b, (size_t) n); }
+static fpos_t
+myleaf_seek (void *c, fpos_t offset, int whence)
+{
+  off_t o = (off_t) offset;
+  return myleaf_seek_impl (c, &o, whence) == 0 ? (fpos_t) o : -1;
+}
+#endif
+
+/* Returns F wrapped in a pass-through stream, or F if hooks are off.  */
+static FILE *
+myleaf_hook (FILE *f, const char *direction, int filefmt, const char *name,
+             const char *mode)
+{
+  struct myleaf_stream *s;
+  FILE *wrapped;
+  if (!f || !myleaf_hooks_enabled ())
+    return f;
+  s = xmalloc (sizeof *s);
+  s->file = f;
+  s->name = xstrdup (name);
+  s->nread = s->nwritten = 0;
+#ifdef __linux__
+  {
+    cookie_io_functions_t io = { myleaf_read, myleaf_write, myleaf_seek,
+                                 myleaf_close_impl };
+    wrapped = fopencookie (s, mode, io);
+  }
+#else
+  wrapped = funopen (s, myleaf_read, myleaf_write, myleaf_seek,
+                     myleaf_close_impl);
+#endif
+  if (!wrapped) {
+    free (s->name);
+    free (s);
+    return f;
+  }
+  myleaf_logf ("open\t%s\t%d\t%s\n", direction, filefmt, name);
+  return wrapped;
+}
+
+static boolean
+myleaf_is_dump_format (int filefmt)
+{
+  return filefmt == kpse_fmt_format || filefmt == kpse_base_format
+         || filefmt == kpse_mem_format;
+}
+#endif /* __linux__ || __APPLE__ */
 
