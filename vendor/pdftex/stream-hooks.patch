 {
     string fname;
 #if defined(PTEX) && !defined(WIN32)
@@ -456,6 +638,10 @@ open_output (FILE **f_ptr, const_string fopen_mode)
             strcpy (nameoffile + 1, fname);
         }
         recorder_record_output (fname);
+#ifdef MYLEAF_HOOKS
+        if (hook)
+            *f_ptr = myleaf_hook (*f_ptr, "out", -1, fname, fopen_mode);
+#endif
     }
     if (fname != nameoffile +1)
         free(fname);
