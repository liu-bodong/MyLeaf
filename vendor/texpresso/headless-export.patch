+// Headless page export (MyLeaf patch). When TEXPRESSO_EXPORT_DIR is set, the
+// whole document is typeset, and each page of the range set by the editor
+// command ["export-pages", first, last] (1-based, default 1-1) is written
+// atomically to <dir>/page-<n>.svg (or .png with TEXPRESSO_EXPORT_FORMAT=png)
+// whenever it is (re)typeset, announced on stdout as
+// ["page-exported", n, "path", milliseconds]. Page count changes are
+// announced as ["page-count", n, finished].
+static void export_page(fz_context *ctx, fz_display_list *dl, int page)
+{
+  const char *dir = getenv("TEXPRESSO_EXPORT_DIR");
+  if (!dir)
+    return;
+  const char *format = getenv("TEXPRESSO_EXPORT_FORMAT");
+  bool png = format && strcmp(format, "png") == 0;
+
+  char path[4096], tmp[4200];
+  snprintf(path, sizeof(path), "%s/page-%d.%s", dir, page + 1, png ? "png" : "svg");
+  snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+
+  struct timespec start, end;
+  clock_gettime(CLOCK_MONOTONIC, &start);
+  fz_rect bounds = fz_bound_display_list(ctx, dl);
+  fz_output *out = NULL;
+  fz_device *dev = NULL;
+  fz_pixmap *pix = NULL;
+  fz_var(out);
+  fz_var(dev);
+  fz_var(pix);
+  fz_try(ctx)
+  {
+    if (png)
+    {
+      pix = fz_new_pixmap_from_display_list(ctx, dl, fz_scale(2, 2), fz_device_rgb(ctx), 0);
+      fz_save_pixmap_as_png(ctx, pix, tmp);
+    }
+    else
+    {
+      out = fz_new_output_with_path(ctx, tmp, 0);
+      dev = fz_new_svg_device(ctx, out, bounds.x1 - bounds.x0, bounds.y1 - bounds.y0,
+                              FZ_SVG_TEXT_AS_PATH, 1);
+      fz_run_display_list(ctx, dl, dev, fz_identity, fz_infinite_rect, NULL);
+      fz_close_device(ctx, dev);
+      fz_close_output(ctx, out);
+    }
+  }
+  fz_always(ctx)
+  {
+    fz_drop_device(ctx, dev);
+    fz_drop_output(ctx, out);
+    fz_drop_pixmap(ctx, pix);
+  }
+  fz_catch(ctx)
+  {
+    fprintf(stderr, "[export] page %d: %s\n", page + 1, fz_caught_message(ctx));
+    return;
+  }
+  if (rename(tmp, path) != 0)
+  {
+    perror("[export] rename");
+    return;
+  }
+  clock_gettime(CLOCK_MONOTONIC, &end);
+  int ms = (int)((end.tv_sec - start.tv_sec) * 1000 + (end.tv_nsec - start.tv_nsec) / 1000000);
+  printf("[\"page-exported\", %d, \"%s\", %d]\n", page + 1, path, ms);
+  fflush(stdout);
+}
+
+// Pages (0-based, inclusive) the editor asked for with "export-pages".
+static int export_first = 0, export_last = 0;
+// Pages below this index are typeset and were exported if in the range.
+static int export_valid = 0;
+static int reported_count = -1, reported_done = -1;
+
+static void export_range(struct persistent_state *ps, ui_state *ui, int from, int to)
+{
+  if (from < export_first)
+    from = export_first;
+  if (to > export_last + 1)
+    to = export_last + 1;
+  for (int page = from; page < to; page++)
+  {
+    fz_display_list *dl = send(render_page, ui->eng, ps->ctx, page);
+    export_page(ps->ctx, dl, page);
+    fz_drop_display_list(ps->ctx, dl);
+  }
+}
+
+// Exports pages of the range that were (re)typeset since the last call and
+// announces page count changes as ["page-count", n, finished].
+static void export_sync(struct persistent_state *ps, ui_state *ui)
+{
+  if (!getenv("TEXPRESSO_EXPORT_DIR"))
+    return;
+  int low = incdvi_take_low_page_count();
+  if (low < export_valid)
+    export_valid = low;
+  int count = send(page_count, ui->eng);
+  if (count < export_valid)
+    export_valid = count;
+  export_range(ps, ui, export_valid, count);
+  export_valid = count;
+
+  int done = send(get_status, ui->eng) == DOC_TERMINATED;
+  if (count != reported_count || done != reported_done)
+  {
+    reported_count = count;
+    reported_done = done;
+    printf("[\"page-count\", %d, %s]\n", count, done ? "true" : "false");
+    fflush(stdout);
+  }
+}
