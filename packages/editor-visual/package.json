{
  "name": "@myleaf/editor-visual",
  "version": "0.0.0",
  "private": true,
  "description": "Visual mode for the LaTeX editor: CodeMirror decorations rendering LaTeX in place (ADR 0016).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "@myleaf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@myleaf/latex-syntax": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
