{
  "name": "@myleaf/latex-syntax",
  "version": "0.0.0",
  "private": true,
  "description": "Structural LaTeX parser with source offsets (commands, arguments, environments, math, comments).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "@myleaf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
